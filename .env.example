# Supabase (required for production / multi-user auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set false once Supabase is connected (otherwise the app keeps using local .data/store.json)
NEXT_PUBLIC_DEMO_MODE=true

# Optional: create/apply the cloud project automatically
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_REGION=us-east-1
DATABASE_URL=

# First admin user created by `npm run setup:supabase`
ADMIN_EMAIL=admin@fleet.local
ADMIN_PASSWORD=

# Optional: Gemini for OCR extraction from uploaded PDFs/images
GEMINI_API_KEY=
OCR_GEMINI_MODEL=gemini-2.5-flash
# Match Google AI Studio → Rate limits for your project (Free Flash is often 10 RPM / 250 RPD).
# Set OCR_GEMINI_RPD_LIMIT=0 to disable the daily cap check (still paced by RPM).
OCR_GEMINI_RPD_LIMIT=250
OCR_GEMINI_RPM_LIMIT=10
# Keep at 1 on free tier to avoid 429s on multi-page PDFs
OCR_PAGE_CONCURRENCY=1
# Pages per serverless OCR call (keeps under Vercel time + Gemini RPM)
OCR_PAGE_CHUNK=12

# App
NEXT_PUBLIC_APP_NAME=Fleet Repair Manager
# Set false later to turn the login page back on
NEXT_PUBLIC_AUTH_DISABLED=true

# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env.local — it is gitignored.
